//@version=5
indicator("OB + FVG STRICT | BTC M5", overlay=true, max_boxes_count=60, max_lines_count=30)

// =========================================================================
//  VERSION BTC — réglages crypto par défaut
//  - Swing lookback 7 (filtre le bruit crypto)
//  - STRICT MODE : un OB n'est affiché QUE s'il chevauche un FVG
//  - Filtre tendance activé d'office
// =========================================================================

swingLen   = input.int(7,   "Swing lookback (force structure)", minval=2, tooltip="7 par défaut pour BTC : filtre les fausses cassures")
strictMode = input.bool(true,"STRICT : OB valide seulement si chevauche un FVG")
useTrend   = input.bool(true, "Filtrer par tendance (EMA)")
emaLen     = input.int(50,  "EMA tendance", minval=10)
maxOB      = input.int(5,   "Nombre max d'OB affichés", minval=1, maxval=20)
extendBars = input.int(30,  "Extension des zones (bougies)", minval=5)
showFVG    = input.bool(true, "Afficher les FVG")

colBull = input.color(color.new(color.teal, 70),  "OB haussier")
colBear = input.color(color.new(color.red,  70),  "OB baissier")
colUsed = input.color(color.new(color.gray, 88),  "OB consommé")
colFVG  = input.color(color.new(color.orange, 82),"FVG")

// =========================================================================
//  TENDANCE
// =========================================================================
ema = ta.ema(close, emaLen)
trendUp   = not useTrend or close > ema
trendDown = not useTrend or close < ema

// =========================================================================
//  STRUCTURE : pivots confirmés (non-repaint)
// =========================================================================
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low,  swingLen, swingLen)

var float lastSwingHigh = na
var float lastSwingLow  = na
if not na(ph)
    lastSwingHigh := ph
if not na(pl)
    lastSwingLow := pl

bosUp   = not na(lastSwingHigh) and close > lastSwingHigh and close[1] <= lastSwingHigh
bosDown = not na(lastSwingLow)  and close < lastSwingLow  and close[1] >= lastSwingLow

// =========================================================================
//  DETECTION FVG sur la bougie de cassure
//  FVG haussier : low[0] > high[2]  -> gap entre [2] et [0]
//  FVG baissier : high[0] < low[2]
// =========================================================================
fvgBullNow = low > high[2]
fvgBearNow = high < low[2]
fvgBullTop = low
fvgBullBot = high[2]
fvgBearTop = low[2]
fvgBearBot = high

// =========================================================================
//  ORDER BLOCK
// =========================================================================
type OB
    box  zone
    float top
    float bot
    bool  bull
    bool  used

var OB[] obs = array.new<OB>()

f_findOB(bool isBull) =>
    idx = -1
    for i = 1 to 10
        if (isBull and close[i] < open[i]) or (not isBull and close[i] > open[i])
            idx := i
            break
    idx

// --- OB haussier ---
if bosUp and trendUp
    okFVG = not strictMode or fvgBullNow
    if okFVG
        k = f_findOB(true)
        if k >= 0
            t = high[k]
            b = low[k]
            bx = box.new(bar_index[k], t, bar_index + extendBars, b, border_color=color.new(color.teal,30), bgcolor=colBull)
            array.push(obs, OB.new(bx, t, b, true, false))

// --- OB baissier ---
if bosDown and trendDown
    okFVG = not strictMode or fvgBearNow
    if okFVG
        k = f_findOB(false)
        if k >= 0
            t = high[k]
            b = low[k]
            bx = box.new(bar_index[k], t, bar_index + extendBars, b, border_color=color.new(color.red,30), bgcolor=colBear)
            array.push(obs, OB.new(bx, t, b, false, false))

// =========================================================================
//  GESTION OB
// =========================================================================
if array.size(obs) > 0
    for i = array.size(obs) - 1 to 0
        ob = array.get(obs, i)
        if not ob.used and low <= ob.top and high>= ob.bot
            ob.used := true
            box.set_bgcolor(ob.zone, colUsed)
            box.set_border_color(ob.zone, color.new(color.gray, 60))
        if not ob.used
            box.set_right(ob.zone, bar_index + extendBars)

while array.size(obs) > maxOB
    old = array.shift(obs)
    box.delete(old.zone)

// =========================================================================
//  AFFICHAGE FVG
// =========================================================================
if showFVG and fvgBullNow
    box.new(bar_index[2], fvgBullTop, bar_index, fvgBullBot, bgcolor=colFVG, border_color=na)
if showFVG and fvgBearNow
    box.new(bar_index[2], fvgBearTop, bar_index, fvgBearBot, bgcolor=colFVG, border_color=na)

// =========================================================================
//  SIGNAUX VISUELS (aide lecture, PAS entree)
// =========================================================================
plotshape(bosUp,   title="BOS Up",   style=shape.triangleup,   location=location.belowbar, color=color.teal, size=size.tiny)
plotshape(bosDown, title="BOS Down", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.tiny)

plot(useTrend ? ema : na, "EMA tendance", color=color.new(color.blue, 50))

// =========================================================================
//  ALERTE : prix entre dans un OB frais (te prévient, tu cherches le rejet)
// =========================================================================
var bool inFreshOB = false
inFreshOB := false
if array.size(obs) > 0
    for i = 0 to array.size(obs) - 1
        ob = array.get(obs, i)
        if not ob.used and low <= ob.top and high >= ob.bot
            inFreshOB := true
alertcondition(inFreshOB, title="Prix dans un OB frais", message="BTC : prix entre dans un Order Block frais - cherche la bougie de rejet M5") 
